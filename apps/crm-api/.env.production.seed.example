# Optional retained credentials. Keep actual values in the ignored .env.production.seed.
# If that file is absent, the seed generates three distinct random passwords on first initialization.
# Quote a supplied password if it contains # so dotenv does not treat the rest as a comment.
ADMIN_PASSWORD=<generated-on-first-initialization>
SAMUEL_PASSWORD=<generated-on-first-initialization>
GRACE_PASSWORD=<generated-on-first-initialization>
