PORT=3000
NODE_ENV=development
# Use the credentials and host port from the root Docker Compose .env.
DATABASE_URL_ADMIN=postgresql://crm_dev:replace-with-local-password@127.0.0.1:5433/crm_dev
FRONTEND_ORIGIN=http://127.0.0.1:5173
SESSION_SECRET=replace-with-a-random-value-of-at-least-32-characters
