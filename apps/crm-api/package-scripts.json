{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    
    "=== Database Operations ===": "",
    "db:migrate": "DATABASE_URL=$DATABASE_URL_ADMIN npx prisma migrate deploy",
    "db:migrate:dev": "DATABASE_URL=$DATABASE_URL_ADMIN npx prisma migrate dev",
    "db:migrate:reset": "DATABASE_URL=$DATABASE_URL_ADMIN npx prisma migrate reset",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    
    "=== Seeding ===": "",
    "db:seed": "DATABASE_URL=$DATABASE_URL_OWNER tsx prisma/seed.ts",
    "db:seed:app": "DATABASE_URL=$DATABASE_URL tsx prisma/seed.ts",
    "db:seed:owner": "DATABASE_URL=$DATABASE_URL_OWNER tsx prisma/seed.ts",
    "db:seed:complete": "DATABASE_URL=$DATABASE_URL_OWNER tsx prisma/seed-complete.ts",
    
    "=== Analytics ===": "",
    "aggregate-analytics": "DATABASE_URL=$DATABASE_URL_OWNER tsx src/scripts/aggregateAnalytics.ts",
    
    "=== Testing ===": "",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
