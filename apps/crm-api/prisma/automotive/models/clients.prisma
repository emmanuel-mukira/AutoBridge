model Client {
  id              Int       @id @default(autoincrement())
  businessName    String
  countyName      String
  locationAddress String
  shortHistory    String?
  ownerId         Int
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner            User                   @relation("ClientOwner", fields: [ownerId], references: [id])
  contacts         Contact[]
  opportunities    Opportunity[]
  interactions     Interaction[]
  followUps        FollowUp[]
  revenueSummaries ClientRevenueSummary[]
  quotations       Quotation[]

  @@index([businessName])
  @@index([ownerId, deletedAt])
}

model Contact {
  id        Int      @id @default(autoincrement())
  clientId  Int
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quotations Quotation[]

  @@index([clientId])
}

enum PurchaseHistoryDeclaration {
  YES
  NO
  NOT_SURE
}

model ClientRevenueSummary {
  id             Int                        @id @default(autoincrement())
  clientId       Int
  amount         Decimal                    @db.Decimal(18, 2)
  currency       String                     @db.VarChar(3)
  coverageStart  DateTime
  coverageEnd    DateTime
  evidenceSource String
  declaration    PurchaseHistoryDeclaration @default(NOT_SURE)
  complete       Boolean                    @default(false)
  verifiedAt     DateTime
  verifiedById   Int?
  createdAt      DateTime                   @default(now())

  client      Client                  @relation(fields: [clientId], references: [id])
  verifiedBy  User?                   @relation(fields: [verifiedById], references: [id])
  predictions OpportunityPrediction[]

  @@index([clientId, coverageEnd])
}
