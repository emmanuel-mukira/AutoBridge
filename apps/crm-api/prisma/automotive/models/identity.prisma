enum UserRole {
  ADMIN
  SALES_REP
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  firstName    String
  lastName     String
  passwordHash String
  role         UserRole @default(SALES_REP)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  sessions                 Session[]
  ownedClients             Client[]                @relation("ClientOwner")
  ownedOpportunities       Opportunity[]           @relation("OpportunityOwner")
  interactions             Interaction[]
  followUps                FollowUp[]
  predictionReviews        PredictionReview[]
  verifiedRevenueSummaries ClientRevenueSummary[]

  @@index([role])
}

model Session {
  id        String    @id
  userId    Int
  tokenHash String    @unique
  csrfHash  String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
