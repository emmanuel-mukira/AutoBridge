enum UserRole {
  ADMIN
  SALES_REP
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  firstName    String
  lastName     String
  passwordHash String
  role         UserRole @default(SALES_REP)
  active       Boolean  @default(true)
  approvedAt   DateTime?
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())

  sessions                 Session[]
  ownedClients             Client[]               @relation("ClientOwner")
  ownedOpportunities       Opportunity[]          @relation("OpportunityOwner")
  interactions             Interaction[]
  followUps                FollowUp[]
  weeklySalesCapacities     WeeklySalesCapacity[]
  predictionReviews        PredictionReview[]
  verifiedRevenueSummaries ClientRevenueSummary[]
  createdQuotations        Quotation[]            @relation("QuotationCreator")

  @@index([role])
}

model WeeklySalesCapacity {
  id               Int      @id @default(autoincrement())
  userId           Int
  weekStart        DateTime @db.Date
  availableMinutes Int
  correctionUsed   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, weekStart])
}

model Session {
  id        String    @id
  userId    Int
  tokenHash String    @unique
  csrfHash  String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
