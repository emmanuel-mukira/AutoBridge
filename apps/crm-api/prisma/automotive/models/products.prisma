model ProductGroup {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  subgroups ProductSubgroup[]
}

model ProductSubgroup {
  id             Int           @id @default(autoincrement())
  productGroupId Int
  name           String
  productGroup   ProductGroup  @relation(fields: [productGroupId], references: [id])
  opportunities  Opportunity[]
  products       Product[]

  @@unique([productGroupId, name])
}

enum ProductPriceClassification {
  PUBLIC_RETAIL_REFERENCE
  VERIFIED_TRADE
  DEMONSTRATION
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  SUPERSEDED
}

model Product {
  id                  Int                        @id @default(autoincrement())
  productSubgroupId   Int
  sku                 String                     @unique
  name                String
  description         String?
  brand               String?
  specifications      String?
  unitOfMeasure       String
  defaultSellingPrice Decimal                    @db.Decimal(18, 2)
  currency            String                     @db.VarChar(3)
  priceSourceName     String
  priceSourceUrl      String
  priceObservedAt     DateTime
  priceClassification ProductPriceClassification
  active              Boolean                    @default(true)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  productSubgroup ProductSubgroup @relation(fields: [productSubgroupId], references: [id], onDelete: Restrict)
  quotationItems  QuotationItem[]

  @@index([productSubgroupId, active])
}

model Quotation {
  id                    Int             @id @default(autoincrement())
  quoteNumber           String
  opportunityId         Int
  clientId              Int
  contactId             Int?
  createdById           Int
  version               Int             @default(1)
  supersedesId          Int?            @unique
  status                QuotationStatus @default(DRAFT)
  current               Boolean         @default(false)
  currency              String          @db.VarChar(3)
  issueDate             DateTime?
  validUntil            DateTime
  subtotal              Decimal         @db.Decimal(18, 2)
  discountPercent       Decimal         @default(0) @db.Decimal(5, 2)
  discountAmount        Decimal         @default(0) @db.Decimal(18, 2)
  totalAmount           Decimal         @db.Decimal(18, 2)
  clientNameSnapshot    String
  clientAddressSnapshot String
  contactNameSnapshot   String?
  notes                 String?
  terms                 String?
  sentAt                DateTime?
  decidedAt             DateTime?
  supersededAt          DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  opportunity  Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  client       Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contact      Contact?        @relation(fields: [contactId], references: [id], onDelete: Restrict)
  createdBy    User            @relation("QuotationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  supersedes   Quotation?      @relation("QuotationSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy Quotation?      @relation("QuotationSupersession")
  items        QuotationItem[]

  @@unique([opportunityId, version])
  @@unique([quoteNumber, version])
  @@index([opportunityId, createdAt])
  @@index([clientId, createdAt])
  @@index([createdById, status])
}

model QuotationItem {
  id                  Int     @id @default(autoincrement())
  quotationId         Int
  productId           Int
  skuSnapshot         String
  productNameSnapshot String
  brandSnapshot       String?
  descriptionSnapshot String?
  unitSnapshot        String
  quantity            Decimal @db.Decimal(12, 3)
  unitPrice           Decimal @db.Decimal(18, 2)
  lineTotal           Decimal @db.Decimal(18, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@index([productId])
}
