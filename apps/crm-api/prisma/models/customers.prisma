enum CustomerCategory {
  SACCOS_BANKS
  SCHOOLS
  CHURCHES
  HOSPITALS
  HOTELS
  NGOS
  INDUSTRIAL
  DOMESTIC
  FARMING_DAIRY
  SUPERMARKETS
  PETROL_STATIONS
  APARTMENTS_COMMERCIALS
  GOVERNMENT_INSTITUTION
  @@schema("crm")
}

enum ContactRoleCategory {
  OWNER_DIRECTOR
  PROCUREMENT
  FACILITY_MANAGER
  ENGINEER_TECHNICAL
  ASSISTANT_RECEPTION_GATEKEEPER
  OTHER
  UNKNOWN
  @@schema("crm")
}

model Customer {
  id              Int               @id @default(autoincrement())
  companyId       Int               @map("company_id")
  companyName     String            @map("company_name")
  countyName      String            @map("county_name")
  locationAddress String            @map("location_address")
  shortHistory    String?           @map("short_history")
  category        CustomerCategory? @map("category")
  salesRepId      Int?              @map("sales_rep_id")
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")

  company      Company           @relation(fields: [companyId], references: [id])
  salesRep     User?             @relation("SalesRepToCustomer", fields: [salesRepId], references: [id])
  contacts     CustomerContact[]
  leads        Lead[]
  quotations   Quotation[]
  callPlans    CallPlan[]
  interactions Interaction[]

  @@index([companyId, companyName])
  @@index([salesRepId, createdAt])
  @@index([category])
  @@index([deletedAt])
  @@schema("crm")
  @@map("customers")
}

model CustomerContact {
  id                  Int                 @id @default(autoincrement())
  customerId          Int                 @map("customer_id")
  firstName           String              @map("first_name")
  lastName            String              @map("last_name")
  title               String?
  contactRoleCategory ContactRoleCategory  @default(UNKNOWN) @map("contact_role_category")
  email               String?
  phone               String?
  isPrimary           Boolean             @default(false) @map("is_primary")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at")

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  callPlans    CallPlan[]
  interactions Interaction[]
  leads        Lead[]

  @@index([customerId, email])
  @@index([customerId, phone])
  @@index([customerId, isPrimary])
  @@schema("crm")
  @@map("customer_contacts")
}
